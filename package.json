{
  "name": "webdevgym-electron",
  "version": "0.17.15",
  "description": "Desktop edition of the WebDevGym learning workspace",
  "author": "kernix01",
  "desktopName": "WebDevGym",
  "main": "electron/main.cjs",
  "private": true,
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/kernix01/WebDevGym-Desktop.git"
  },
  "scripts": {
    "prepare:editor": "node tools/prepare-editor-vendor.cjs",
    "desktop": "npm run prepare:editor && electron .",
    "desktop:dev": "npm run prepare:editor && electron . --dev",
    "desktop:pack": "npm run prepare:editor && npm run test:desktop && node tools/build-desktop.cjs --dir",
    "desktop:build": "npm run prepare:editor && npm run test:desktop && node tools/build-desktop.cjs",
    "desktop:build:windows": "npm run prepare:editor && npm run test:desktop && node tools/build-desktop.cjs --win",
    "desktop:build:linux": "npm run prepare:editor && node tools/build-desktop.cjs --linux",
    "desktop:build:arch": "npm run prepare:editor && node tools/build-desktop.cjs --pacman-only",
    "sync:web": "node tools/sync-web.cjs",
    "test": "npm run test:desktop",
    "test:desktop": "node tools/test-code-editor.cjs && node tools/test-diagnostics.cjs && node tools/test-device-sync.cjs && node tools/test-electron-shell.cjs && node tools/test-desktop-services.cjs && node tools/test-vsix-extensions.cjs",
    "test:smoke": "npm run prepare:editor && node tools/smoke-electron.cjs"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.kernix01.webdevgym.desktop",
    "productName": "WebDevGym",
    "asar": true,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "build/icon.png",
      "electron/**/*",
      "web/**/*",
      "LICENSE"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "installer/context-menu.nsh",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    },
    "linux": {
      "category": "Development",
      "maintainer": "kernix01",
      "syncDesktopName": true,
      "synopsis": "WebDevGym learning workspace",
      "target": [
        "AppImage",
        "deb",
        "pacman"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "compression": "gz",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ]
    },
    "pacman": {
      "artifactName": "${productName}-${version}-${arch}.pkg.tar.zst",
      "compression": "zstd",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libxss",
        "libxtst",
        "xdg-utils",
        "at-spi2-core",
        "libsecret"
      ]
    }
  },
  "dependencies": {
    "emmet-monaco-es": "^5.7.0",
    "eslint": "^10.11.0",
    "html-validate": "^11.16.1",
    "jsonc-parser": "^3.3.1",
    "monaco-editor": "^0.57.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "5.9.3",
    "ws": "^8.22.0",
    "yauzl": "^3.4.0"
  }
}
